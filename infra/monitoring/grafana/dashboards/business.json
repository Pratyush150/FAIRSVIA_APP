{
  "uid": "ridevela-business",
  "title": "FAIRSVIA \u2014 Business",
  "description": "Is the business working. Answered from Postgres, not Prometheus: these are ledger questions, and the metrics store only keeps 30 days of samples.",
  "tags": [
    "ridevela",
    "business"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Today",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Rides completed today",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT count(*) AS value FROM trips WHERE status = 'completed' AND completed_at >= date_trunc('day', now());",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 40
        }
      }
    },
    {
      "type": "stat",
      "title": "Gross revenue today",
      "description": "Captured ride payments only \u2014 excludes tips, which are charged separately, and refunds.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT COALESCE(sum(amount), 0) AS value FROM payments WHERE status IN ('captured','collected') AND kind = 'ride' AND created_at >= date_trunc('day', now());",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 40
        }
      }
    },
    {
      "type": "stat",
      "title": "Platform fee today",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT COALESCE(sum(platform_fee), 0) AS value FROM payments WHERE status IN ('captured','collected') AND kind = 'ride' AND created_at >= date_trunc('day', now());",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 40
        }
      }
    },
    {
      "type": "stat",
      "title": "Completion rate (7d)",
      "description": "Completed as a share of every trip that reached dispatch. Cancellations and no-driver timeouts both count against it.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT COALESCE(count(*) FILTER (WHERE status = 'completed')::float / NULLIF(count(*), 0), 0) AS value FROM trips WHERE requested_at >= now() - interval '7 days';",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 40
        }
      }
    },
    {
      "type": "row",
      "title": "Trend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Trips per hour by outcome",
      "description": "The funnel over time, from the trips table rather than the metrics store \u2014 so it survives longer than Prometheus retention.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT date_trunc('hour', requested_at) AS time, status AS metric, count(*) AS value FROM trips WHERE $__timeFilter(requested_at) GROUP BY 1, 2 ORDER BY 1;",
          "format": "time_series",
          "rawQuery": true,
          "legendFormat": "{{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "axisLabel": "",
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_drivers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expired"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "payment_failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in_progress"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008300"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Revenue per hour",
      "description": "Both lines are dollars, so they share one axis honestly.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, sum(amount) AS \"gross\", sum(platform_fee) AS \"platform fee\" FROM payments WHERE $__timeFilter(created_at) AND status IN ('captured','collected') AND kind = 'ride' GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "axisLabel": "",
            "gradientMode": "none"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gross"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "platform fee"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Why rides end",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Cancellations by reason (7d)",
      "description": "Ops signal, not a vanity metric: a spike in one reason is usually a bug or a pricing problem, not riders changing their minds.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT COALESCE(cancel_reason, '(none given)') AS reason, count(*) AS trips FROM trips WHERE status = 'cancelled' AND requested_at >= now() - interval '7 days' GROUP BY 1 ORDER BY trips DESC LIMIT 20;",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Admin actions (audit log)",
      "description": "Every privileged write: refunds, fare and surge edits, driver verification, user deactivation. Failed attempts included \u2014 those are often the interesting ones.",
      "datasource": {
        "type": "postgres",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ridevela-postgres"
          },
          "rawSql": "SELECT a.created_at AS \"when\", u.full_name AS \"who\", a.action, a.target_id AS target, a.status_code AS status FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id ORDER BY a.created_at DESC LIMIT 50;",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    }
  ]
}
