    {
      "type": "stat",
      "title": "Time to find a driver",
      "id": 8,
      "description": "How long the slowest 5% of riders waited for a driver to accept.",
      "datasource": {
        "type": "prometheus",
        "uid": "fairsvia-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fairsvia-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(trip_match_duration_seconds_bucket[$__range])) by (le))",
