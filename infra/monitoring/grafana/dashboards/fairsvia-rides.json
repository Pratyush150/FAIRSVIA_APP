    {
      "type": "stat",
      "title": "Average wait for the car",
      "id": 7,
      "description": "From a driver accepting to arriving at the pickup.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairsvia-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(extract(epoch FROM arrived_at - accepted_at)) FROM trips WHERE arrived_at IS NOT NULL AND $__timeFilter(accepted_at)"
        }
      ],
