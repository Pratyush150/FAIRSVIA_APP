          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(fare_final) FROM trips WHERE status = 'completed' AND currency = 'INR' AND $__timeFilter(completed_at)"
