    {
      "type": "stat",
      "title": "Rides cancelled by drivers",
      "id": 7,
      "description": "Of rides a driver accepted, how many that driver then cancelled.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ridevela-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'cancelled' AND cancelled_by = 'driver')::float / NULLIF(count(*) FILTER (WHERE accepted_at IS NOT NULL), 0) FROM trips WHERE $__timeFilter(requested_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Rides per driver",
      "id": 8,
      "description": "Average completed rides per driver who drove.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ridevela-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*)::float / NULLIF(count(DISTINCT driver_id), 0) FROM trips WHERE status = 'completed' AND $__timeFilter(completed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0FA3A8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
