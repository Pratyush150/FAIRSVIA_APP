    {
      "type": "stat",
      "title": "Used the app today",
      "id": 5,
      "description": "Drivers who opened the driver app today.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ridevela-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM user_active_days a JOIN driver_profiles dp ON dp.user_id = a.user_id WHERE a.day = (now() AT TIME ZONE 'Asia/Kolkata')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
