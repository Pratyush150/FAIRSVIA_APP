    {
      "type": "timeseries",
      "title": "Drivers online through the day",
      "id": 9,
      "description": "Supply in the chosen period.",
      "datasource": {
        "type": "prometheus",
        "uid": "ridevela-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ridevela-prometheus"
          },
          "refId": "A",
          "expr": "sum(drivers_online) or vector(0)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "Online"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ridevela-prometheus"
          },
          "refId": "B",
          "expr": "(sum(drivers_online) or vector(0)) - (sum(drivers_on_trip) or vector(0))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "Free"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ridevela-prometheus"
          },
          "refId": "C",
          "expr": "sum(drivers_on_trip) or vector(0)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "On a ride"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Top drivers",
      "id": 10,
      "description": "Most completed rides in the chosen period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ridevela-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ridevela-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(u.full_name, 'Driver ' || right(u.phone, 4)) AS \"Driver\", count(*) AS \"Rides\", round(sum(COALESCE(p.driver_payout, 0))::numeric, 0) AS \"Earned (₹)\" FROM trips t JOIN users u ON u.id = t.driver_id LEFT JOIN payments p ON p.trip_id = t.id WHERE t.status = 'completed' AND $__timeFilter(t.completed_at) GROUP BY u.id ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    }
  ]
}
