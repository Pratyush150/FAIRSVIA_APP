    {
      "type": "stat",
      "title": "Offers accepted",
      "id": 6,
      "description": "Of the ride offers sent to drivers, how many they accepted.",
      "datasource": {
        "type": "prometheus",
        "uid": "ridevela-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ridevela-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(dispatch_offers_total{outcome=\"accepted\"}[$__range])) / sum(increase(dispatch_offers_total[$__range]))",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
