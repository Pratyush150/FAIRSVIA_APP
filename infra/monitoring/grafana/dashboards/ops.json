        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ridevela-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(trip_match_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
