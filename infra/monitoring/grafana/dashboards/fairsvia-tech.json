    {
      "type": "table",
      "title": "Alarms going off now",
      "id": 2,
      "description": "Every automatic alarm currently firing. Rules: infra/monitoring/prometheus/alerts.yml.",
      "datasource": {
        "type": "prometheus",
        "uid": "fairsvia-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fairsvia-prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    },
    {
      "type": "stat",
      "title": "App server",
      "id": 3,
      "description": "1 = the server is answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "fairsvia-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fairsvia-prometheus"
          },
          "refId": "A",
          "expr": "max(up{job=\"backend\"}) or vector(0)",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
