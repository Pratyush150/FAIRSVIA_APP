    {
      "type": "timeseries",
      "title": "Money per day",
      "id": 9,
      "description": "Last 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairsvia-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(paid_at, 1d, 0), sum(amount) AS \"Money in\", sum(platform_fee) AS \"We kept\" FROM (SELECT COALESCE(t.completed_at, p.updated_at) AS paid_at, p.amount, p.platform_fee FROM payments p JOIN trips t ON t.id = p.trip_id WHERE p.status IN ('captured','collected','partial','refunded') AND p.currency = 'INR') s WHERE $__timeFilter(paid_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
