    {
      "type": "stat",
      "title": "Money in",
      "id": 2,
      "description": "Everything riders paid: fares and cancellation fees, before refunds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairsvia-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(p.amount), 0) FROM payments p JOIN trips t ON t.id = p.trip_id WHERE p.status IN ('captured','collected','partial','refunded') AND p.currency = 'INR' AND $__timeFilter(COALESCE(t.completed_at, p.updated_at))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0FA3A8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
