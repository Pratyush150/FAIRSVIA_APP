    {
      "type": "stat",
      "title": "Paid in cash",
      "id": 6,
      "description": "Share of paid rides settled in cash.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
