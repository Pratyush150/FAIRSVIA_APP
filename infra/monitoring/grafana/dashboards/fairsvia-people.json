    {
      "type": "timeseries",
      "title": "People using the app each day",
      "id": 6,
      "description": "Last 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairsvia-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT a.day::timestamptz AS time, count(*) FILTER (WHERE dp.user_id IS NULL) AS \"Riders\", count(*) FILTER (WHERE dp.user_id IS NOT NULL) AS \"Drivers\" FROM user_active_days a LEFT JOIN driver_profiles dp ON dp.user_id = a.user_id WHERE a.day >= $__timeFrom()::date GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "timeFrom": "30d",
      "hideTimeOverride": false
    },
    {
      "type": "timeseries",
      "title": "Total accounts over time",
      "id": 7,
      "description": "Last 30 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fairsvia-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fairsvia-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT d AS time, (SELECT count(*) FROM users u WHERE u.role <> 'admin' AND u.deleted_at IS NULL AND u.created_at < d + interval '1 day') AS \"All accounts\", (SELECT count(*) FROM driver_profiles dp WHERE dp.created_at < d + interval '1 day') AS \"Drivers\" FROM generate_series(date_trunc('day', $__timeFrom()::timestamptz), date_trunc('day', $__timeTo()::timestamptz), interval '1 day') d ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "timeFrom": "30d",
      "hideTimeOverride": false
    }
