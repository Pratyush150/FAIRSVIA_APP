# Compose-level secrets for the PRODUCTION stack (docker-compose.prod.yml).
# Copy to infra/.env and set strong random values. These are interpolated by
# docker compose into the postgres/redis services and the backend DATABASE_URL/
# REDIS_URL. The stack refuses to start if they are unset.
#
#   cp infra/.env.example infra/.env    # then edit
#   openssl rand -base64 24             # to generate each value

POSTGRES_PASSWORD=change_me_strong_db_password
REDIS_PASSWORD=change_me_strong_redis_password

# --- TLS (infra/tls/README.md) ---
# Public API hostname the certificate is issued for.
TLS_DOMAIN=api.fairsvia.com
# On the real server these must be the standard ports (Let's Encrypt connects
# to :80; the apps expect :443). Defaults are 8088/8443 to avoid clashes.
HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres backups (infra/backup/README.md) ---
BACKUP_HOST_DIR=/var/backups/fairsvia
# 21:00 UTC = 02:00 Tashkent.
BACKUP_HOUR_UTC=21
