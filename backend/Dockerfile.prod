# Production image for the NestJS backend — multi-stage, no source mount, runs
# the compiled dist as a non-root user. Used by infra/docker-compose.prod.yml.
# (The dev image stays in ./Dockerfile with hot-reload + bind mount.)

# ---- build stage: full deps + compile ----
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY . .
RUN npm run build

# ---- runtime stage: prod deps only + compiled output ----
FROM node:22-bookworm-slim AS prod
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update -y && apt-get install -y openssl curl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev && npm cache clean --force
COPY prisma ./prisma
# Regenerate the client against the runtime deps (prisma is a prod dep so the
# entrypoint's `migrate deploy` works too).
RUN npx prisma generate
COPY --from=build /app/dist ./dist
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && chown -R node:node /app

USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS http://localhost:3000/api/v1/health || exit 1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]
