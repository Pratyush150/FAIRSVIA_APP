# Production env for docker-compose.prod.yml. Copy to backend/.env.prod and set
# real values. DATABASE_URL / REDIS_URL are injected by the compose file (they
# point at the prod postgres/redis services), so you don't set them here.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- SECRETS: generate strong random values before any real use ---
# The backend REFUSES TO BOOT in production if these are unset, still contain
# "change_me", are shorter than 32 chars, or are equal to each other.
# Generate e.g. with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP — 6 digits so the code space (10^6) resists online brute force.
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Browser origins allowed to make credentialed requests (comma-separated).
# In production the API only accepts CORS from these exact origins; leaving it
# empty blocks all cross-origin browser calls.
CORS_ORIGINS=https://admin.example.com

# Require admin document review before a driver can go online (no auto-approve).
DRIVER_AUTO_VERIFY=false

# Marketplace economics
PLATFORM_FEE_PERCENT=0.20
CANCELLATION_FEE=30

# Bootstrap admin accounts (comma-separated phone numbers).
ADMIN_PHONES=+919900000001

# --- External providers ---
# SMS_PROVIDER MUST NOT be "mock" in production (the backend refuses to boot):
# the mock provider never sends a real code. Configure a real provider/key.
SMS_PROVIDER=
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
FCM_SERVER_KEY=
