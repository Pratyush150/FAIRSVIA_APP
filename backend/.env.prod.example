# Production env for docker-compose.prod.yml. Copy to backend/.env.prod and set
# real values. DATABASE_URL / REDIS_URL are injected by the compose file (they
# point at the prod postgres/redis services), so you don't set them here.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- SECRETS: generate strong random values before any real use ---
# The backend REFUSES TO BOOT in production if these are unset, still contain
# "change_me", are shorter than 32 chars, or are equal to each other.
# Generate e.g. with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP — 6 digits so the code space (10^6) resists online brute force.
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Browser origins allowed to make credentialed requests (comma-separated).
# In production the API only accepts CORS from these exact origins; leaving it
# empty blocks all cross-origin browser calls.
CORS_ORIGINS=https://admin.example.com

# Require admin document review before a driver can go online (no auto-approve).
# REQUIRED to be "false" in production: the backend refuses to boot otherwise,
# because auto-verify lets anyone self-onboard as a verified driver.
DRIVER_AUTO_VERIFY=false

# Marketplace economics
PLATFORM_FEE_PERCENT=0.20
CANCELLATION_FEE=5

# Bootstrap admin accounts (comma-separated phone numbers).
ADMIN_PHONES=+19900000001

# --- External providers ---
# SMS_PROVIDER MUST NOT be "mock" in production (the backend refuses to boot):
# the mock provider never sends a real code. Set "twilio" and the creds below.
SMS_PROVIDER=
# Twilio (used when SMS_PROVIDER=twilio). TWILIO_API_BASE_URL is optional and
# defaults to https://api.twilio.com — override only to point at a mock/proxy.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_API_BASE_URL=
GOOGLE_MAPS_API_KEY=
# Stripe. BOTH STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are REQUIRED in
# production — the backend refuses to boot if either is empty. An empty secret
# key would silently select the mock payment provider (rides complete without
# charging anyone); an empty webhook secret rejects every Stripe webhook so
# payment_failed / account.updated state never lands.
# STRIPE_API_BASE_URL is optional (defaults to https://api.stripe.com/v1);
# override only to point at a mock endpoint for testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_API_BASE_URL=
FCM_SERVER_KEY=
# Checkr driver background checks. Empty CHECKR_API_KEY = mock provider.
# CHECKR_API_BASE_URL defaults to https://api.checkr.com/v1 (override for a mock).
CHECKR_API_KEY=
CHECKR_PACKAGE=driver_standard
# CHECKR_API_BASE_URL=
# Error tracking (Sentry). Empty SENTRY_DSN = disabled (Sentry.init with no dsn
# is a documented no-op) — set it to actually receive production exceptions.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# SOS call buttons, "Label:number" in display order. Pune pilot shown;
# Uzbekistan: Police:102,Ambulance:103,Fire:101.
EMERGENCY_NUMBERS=Emergency:112,Police:100,Ambulance:108
