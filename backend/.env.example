# Backend environment (copy to .env). Never commit real secrets.
NODE_ENV=development
PORT=3000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://ubernav:ubernav@postgres:5432/ubernav?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# In dev the SMS provider prints the code to the console and the API echoes it back.
# Set to `sns` (Amazon SNS) or `twilio` for real delivery. `sns` uses the AWS_*
# credentials below. In the SNS SMS sandbox only verified numbers receive texts.
SMS_PROVIDER=mock

# AWS credentials shared by SNS (SMS) and SES (email). Leave AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY empty to keep the mock providers.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Transactional email (receipts). `ses` uses Amazon SES + the AWS_* creds above
# and SES_FROM (must be a verified sender; in the SES sandbox recipients must be
# verified too). Anything else uses the mock provider.
EMAIL_PROVIDER=mock
SES_FROM=noreply@fairsvia.com

# Google Maps Platform (Places, Directions, Geocoding). Leave empty to use the
# deterministic stub geo provider (works offline, no key needed).
GOOGLE_MAPS_API_KEY=

# Self-hosted OpenStreetMap routing (OSRM) + geocoding (Nominatim). When both
# are set and no Google key is configured, the OSM provider is used — real
# road-following routes + real place search. Point at the docker-compose
# services (default below) or the public OSM demo servers.
OSRM_BASE_URL=http://osrm:5000
NOMINATIM_BASE_URL=http://nominatim:8080

# Payments. Leave STRIPE_SECRET_KEY empty to use the mock payment provider
# (auth-hold/capture/payout simulated, no charges). Set it (test key) for real Stripe.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...) — handed to the client so flutter_stripe can
# tokenize cards. Empty keeps the app's mock add-card flow.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=
# Deep links Stripe Connect onboarding returns the driver to.
STRIPE_CONNECT_RETURN_URL=fairsvia-driver://connect/return
STRIPE_CONNECT_REFRESH_URL=fairsvia-driver://connect/refresh
# Point the Stripe REST calls at a local mock endpoint for integration tests.
# STRIPE_API_BASE_URL=https://api.stripe.com/v1
# Market. MARKET_CURRENCY (ISO 4217) prices new trips, payments, payouts and
# ledger views; existing rows keep their own currency. BUSINESS_TZ is where
# "today" starts (earnings, dashboards, daily-active users). Fares per tier
# are in the fare_config table (admin console → Pricing), per mile internally
# (the console edits them per km in metric markets). Pair with the apps'
# --dart-define=MARKET=in|uz|us.
#   Pune pilot:      MARKET_CURRENCY=INR  BUSINESS_TZ=Asia/Kolkata  CANCELLATION_FEE=50
#   Uzbekistan:      MARKET_CURRENCY=UZS  BUSINESS_TZ=Asia/Tashkent
MARKET_CURRENCY=USD
BUSINESS_TZ=Asia/Tashkent
# The SOS sheet's call buttons, "Label:number" in display order (max three
# shown). Set per country — a wrong number is worse than none. Default is
# Uzbekistan (Police:102,Ambulance:103,Fire:101).
#   Pune pilot:  EMERGENCY_NUMBERS=Emergency:112,Police:100,Ambulance:108
PLATFORM_FEE_PERCENT=0.20
# Charged only when the rider cancels after a driver committed (accepted /
# arrived) AND more than 2 minutes have passed since acceptance (grace window).
# Must match the code default in common/config/configuration.ts (5).
CANCELLATION_FEE=5
# Driver may tap "Arrived" only within this many metres of the pickup (per
# their last fresh GPS fix; skipped when no fresh fix is known).
ARRIVAL_RADIUS_M=150
# Complete always ends the trip where the driver is. Beyond this far from the
# drop-off (or, with no fresh fix, under COMPLETE_MIN_DRIVEN_M driven) it is a
# short trip: metered fare with the minimum-fare floor, never the estimate.
COMPLETE_DROPOFF_RADIUS_M=500
COMPLETE_MIN_DRIVEN_M=200

# Push notifications. Leave empty to use the mock (logs only). For real push,
# paste a Firebase service-account JSON (one line) — this uses FCM HTTP v1.
# (FCM_SERVER_KEY is the old legacy API, discontinued in 2024; kept only so an
# old value produces a clear warning.)
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# --- Dispatch & live-trip watchdog tuning (all optional; defaults shown) ---
# How long a driver's offer card counts down before dispatch moves to the next
# driver. Clamped server-side to 5000–30000 regardless of what is set here:
# a long window strands the waiting rider behind every driver who ghosts.
OFFER_TTL_MS=15000
# A candidate with no GPS ping in this window is treated as gone and dropped
# from the dispatch pool (crashed app / lost network without going offline).
PRESENCE_STALE_MS=45000
# Rider-facing GPS watchdogs. Deviation: metres off the drawn route that counts
# as leaving it, metres back within it that counts as returning, and how many
# consecutive deviating fixes are needed before the rider is told (one bad fix
# is GPS noise). Stopped: how far counts as having moved, and how long a
# standstill lasts before the rider is told.
OFF_ROUTE_M=120
OFF_ROUTE_CLEAR_M=60
OFF_ROUTE_PINGS=3
STOPPED_RADIUS_M=50
STOPPED_AFTER_S=180
# Minimum gap between live route recomputes for one trip (bounds routing calls).
REROUTE_MIN_GAP_S=30

# Error tracking (Sentry). Empty = disabled (no-op init) — same mock/real
# pattern as every other provider above.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Live trip tracking links (share module). Public origin the links point at,
# e.g. https://track.example.com. Leave empty to derive it from the request
# host (the Cloudflare quick-tunnel URL changes on every restart).
PUBLIC_BASE_URL=
