# Backend environment (copy to .env). Never commit real secrets.
NODE_ENV=development
PORT=3000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://ubernav:ubernav@postgres:5432/ubernav?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# In dev the SMS provider prints the code to the console and the API echoes it back.
SMS_PROVIDER=mock

# Google Maps Platform (Places, Directions, Geocoding). Leave empty to use the
# deterministic stub geo provider (works offline, no key needed).
GOOGLE_MAPS_API_KEY=

# Self-hosted OpenStreetMap routing (OSRM) + geocoding (Nominatim). When both
# are set and no Google key is configured, the OSM provider is used — real
# road-following routes + real place search. Point at the docker-compose
# services (default below) or the public OSM demo servers.
OSRM_BASE_URL=http://osrm:5000
NOMINATIM_BASE_URL=http://nominatim:8080

# Payments. Leave STRIPE_SECRET_KEY empty to use the mock payment provider
# (auth-hold/capture/payout simulated, no charges). Set it (test key) for real Stripe.
STRIPE_SECRET_KEY=
PLATFORM_FEE_PERCENT=0.20
CANCELLATION_FEE=30

# Push notifications. Leave empty to use the mock (logs only). For real push,
# paste a Firebase service-account JSON (one line) — this uses FCM HTTP v1.
# (FCM_SERVER_KEY is the old legacy API, discontinued in 2024; kept only so an
# old value produces a clear warning.)
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=
