// Ride App Prisma schema.
// Phase 0: users + refresh tokens. Geo/trip tables arrive in later phases.
// Note: PostGIS is enabled via infra/postgres-init/ and used through raw SQL
// in later phases (Prisma has limited native support for the geography type).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  rider
  driver
  admin
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @unique @db.VarChar(20)
  email       String?  @db.VarChar(255)
  fullName    String?  @map("full_name") @db.VarChar(120)
  photoUrl    String?  @map("photo_url")
  role        UserRole @default(rider)
  ratingAvg   Decimal  @default(5.00) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int      @default(0) @map("rating_count")
  isActive    Boolean  @default(true) @map("is_active")
  // Stripe Customer (cus_...) — created lazily on the first saved card so
  // charges/holds reference a real customer, not the Ride App user id.
  stripeCustomerId String? @map("stripe_customer_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens  RefreshToken[]
  riderTrips     Trip[]          @relation("RiderTrips")
  driverTrips    Trip[]          @relation("DriverTrips")
  savedPlaces    SavedPlace[]
  driverProfile  DriverProfile?
  paymentMethods PaymentMethod[]
  deviceTokens   DeviceToken[]

  @@map("users")
}

/// A registered push-notification target (one per device). The provider token
/// is opaque (FCM/APNs); we mock the actual send until a real key is set.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @default("android") @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// 1:1 with a user who is a driver. Live online/offline status is tracked in
/// Redis (hot path); this row holds the durable vehicle + verification data.
model DriverProfile {
  userId       String   @id @map("user_id") @db.Uuid
  status       String   @default("offline") @db.VarChar(12)
  vehicleMake  String?  @map("vehicle_make") @db.VarChar(60)
  vehicleModel String?  @map("vehicle_model") @db.VarChar(60)
  vehicleColor String?  @map("vehicle_color") @db.VarChar(30)
  plateNumber  String?  @map("plate_number") @db.VarChar(20)
  vehicleTier  RideTier @default(economy) @map("vehicle_tier")
  licenseNo    String?  @map("license_no") @db.VarChar(60)
  docsVerified Boolean  @default(false) @map("docs_verified")
  totalTrips   Int      @default(0) @map("total_trips")

  // Driver background check (Checkr in prod). Status is the normalized
  // none|pending|clear|consider|suspended; candidate/report are vendor ids.
  bgcStatus      String  @default("none") @map("bgc_status") @db.VarChar(12)
  bgcCandidateId String? @map("bgc_candidate_id")
  bgcReportId    String? @map("bgc_report_id")

  // Stripe Connect Express payout account (acct_...). `payoutsEnabled` mirrors
  // Stripe's charges/payouts-enabled flag, flipped by the account.updated
  // webhook once onboarding (KYC + bank) is complete.
  stripeAccountId String? @map("stripe_account_id") @db.VarChar(64)
  payoutsEnabled  Boolean @default(false) @map("payouts_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

enum TripStatus {
  scheduled
  requested
  matching
  accepted
  arrived
  in_progress
  completed
  cancelled
  no_drivers
  payment_failed
  expired
}

enum RideTier {
  economy
  comfort
  xl
  premium
}

/// A ride. Pickup/dropoff are stored as lat/lng floats in Phase 1; a PostGIS
/// geography column can be added later for analytics/replay (matching in
/// Phase 2 uses Redis GEO, not Postgres).
model Trip {
  id              String     @id @default(uuid()) @db.Uuid
  riderId         String     @map("rider_id") @db.Uuid
  driverId        String?    @map("driver_id") @db.Uuid
  status          TripStatus @default(requested)
  tier            RideTier   @default(economy)

  pickupAddr      String?    @map("pickup_addr")
  pickupLat       Float      @map("pickup_lat")
  pickupLng       Float      @map("pickup_lng")
  dropoffAddr     String?    @map("dropoff_addr")
  dropoffLat      Float      @map("dropoff_lat")
  dropoffLng      Float      @map("dropoff_lng")

  /// A short pickup note from the rider to the driver ("meet at the north gate",
  /// "wearing a red jacket"). Shown on the driver's offer + en-route screens.
  pickupNote      String?    @map("pickup_note")

  /// Set when this ride was booked for somebody else: `riderId` stays the
  /// account that booked and pays, and these describe who is actually
  /// travelling. The driver is shown these instead of the booker's details,
  /// and the passenger is texted the start code — they may not have the app.
  /// Both null = the booker is the passenger, the ordinary case.
  passengerName   String?    @map("passenger_name") @db.VarChar(80)
  passengerPhone  String?    @map("passenger_phone") @db.VarChar(20)

  routePolyline   String?    @map("route_polyline")
  stops           Json?      // ordered intermediate stops: [{lat,lng,addr?}]
  distanceM       Int?       @map("distance_m")
  durationS       Int?       @map("duration_s")
  fareEstimate    Decimal?   @map("fare_estimate") @db.Decimal(10, 2)
  fareFinal       Decimal?   @map("fare_final") @db.Decimal(10, 2)
  surgeMultiplier Decimal    @default(1.0) @map("surge_multiplier") @db.Decimal(3, 2)
  currency        String     @default("USD") @db.VarChar(3)
  startOtp        String?    @map("start_otp") @db.VarChar(4)
  promoCode       String?    @map("promo_code") @db.VarChar(24)
  promoDiscount   Decimal    @default(0) @map("promo_discount") @db.Decimal(10, 2)
  paymentMode     String     @default("card") @map("payment_mode") @db.VarChar(4) // card|cash
  // The rider's chosen saved card for this ride (validated to belong to the
  // rider at creation). Null = charge the rider's default method.
  paymentMethodId String?    @map("payment_method_id") @db.Uuid

  cancelReason    String?    @map("cancel_reason")
  cancelledBy     String?    @map("cancelled_by") @db.VarChar(10)

  scheduledAt     DateTime?  @map("scheduled_at") @db.Timestamptz(6)
  requestedAt     DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz(6)
  arrivedAt       DateTime?  @map("arrived_at") @db.Timestamptz(6)
  startedAt       DateTime?  @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)

  rider   User        @relation("RiderTrips", fields: [riderId], references: [id])
  driver  User?       @relation("DriverTrips", fields: [driverId], references: [id])
  events  TripEvent[]
  payment Payment?
  ratings Rating[]

  @@index([riderId, requestedAt(sort: Desc)])
  @@index([driverId, requestedAt(sort: Desc)])
  @@index([status])
  @@map("trips")
}

/// A saved card (or other method). We store only a provider reference, never
/// raw card data. `provider` is `mock` until Stripe is configured.
model PaymentMethod {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @default("mock") @db.VarChar(12)
  externalId String?  @map("external_id")
  brand      String?  @db.VarChar(20)
  last4      String?  @db.VarChar(4)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

/// One payment per trip (the ride charge, or a cancellation fee for a cancelled
/// trip). Holds the platform-fee / driver-payout split.
model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  tripId           String   @unique @map("trip_id") @db.Uuid
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD") @db.VarChar(3)
  status           String   @default("pending") @db.VarChar(12) // pending|authorized|captured|collected|failed|refunded
  kind             String   @default("ride") @db.VarChar(12) // ride|cancellation
  method           String   @default("card") @db.VarChar(4) // card|cash
  externalIntentId String?  @map("external_intent_id")
  // Reused across retries of the same auth/capture/charge so a network retry
  // never double-charges (Stripe Idempotency-Key header).
  idempotencyKey   String?  @map("idempotency_key") @db.VarChar(64)
  driverPayout     Decimal? @map("driver_payout") @db.Decimal(10, 2)
  platformFee      Decimal? @map("platform_fee") @db.Decimal(10, 2)
  tip              Decimal  @default(0) @db.Decimal(10, 2)
  refundedAmount   Decimal  @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  refundReason     String?  @map("refund_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip    Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  refunds PaymentRefund[]

  @@map("payments")
}

/// One refund attempt against a payment. The row is committed BEFORE the
/// provider call (status `pending`) so a retried/duplicated request can never
/// refund twice: the provider call is keyed on this row's id (Idempotency-Key),
/// and the outcome is recorded as `succeeded` / `failed`.
model PaymentRefund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  amount           Decimal  @db.Decimal(10, 2)
  status           String   @default("pending") @db.VarChar(12) // pending|succeeded|failed
  reason           String?
  externalRefundId String?  @map("external_refund_id")
  failureMessage   String?  @map("failure_message")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tripId])
  @@map("payment_refunds")
}

/// A processed Stripe webhook event, keyed by Stripe's event id. Stripe may
/// deliver the same event more than once; we upsert-on-first-see and skip any
/// id we've already handled, so webhook processing is idempotent.
model WebhookEvent {
  id          String   @id @db.VarChar(64) // Stripe event id, e.g. evt_...
  type        String   @db.VarChar(60)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

/// A single movement in a driver's payout balance. `amount` is signed:
/// positive credits the driver (ride earning, tip, cancellation comp), negative
/// debits (commission owed on a cash ride, a withdrawal). Balance = SUM(amount).
model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  type      String   @db.VarChar(12) // earning|tip|commission|withdrawal|adjustment
  amount    Decimal  @db.Decimal(10, 2)
  tripId    String?  @map("trip_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([driverId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

/// A support ticket raised by a rider or driver. `status` is open|active|
/// resolved|closed. Optionally references the trip it's about.
model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  subject   String   @db.VarChar(140)
  category  String   @default("other") @db.VarChar(20)
  status    String   @default("open") @db.VarChar(12)
  tripId    String?  @map("trip_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages SupportMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("support_tickets")
}

/// One message in a support ticket thread. `authorRole` is user|admin.
model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorRole String   @map("author_role") @db.VarChar(8)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// A persisted in-app notification (the inbox). Mirrors every push we send so
/// the user can review milestones later. `readAt` is null until acknowledged.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  kind      String?   @db.VarChar(24)
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// A rider's favourite driver. Dispatch offers a rider's favourites first when
/// they are among the nearby available drivers.
model FavoriteDriver {
  id        String   @id @default(uuid()) @db.Uuid
  riderId   String   @map("rider_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([riderId, driverId])
  @@index([riderId])
  @@map("favorite_drivers")
}

/// Two-way rating: one per (trip, rater).
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  fromUser  String   @map("from_user") @db.Uuid
  toUser    String   @map("to_user") @db.Uuid
  stars     Int
  comment   String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, fromUser])
  @@index([toUser])
  @@map("ratings")
}

/// Append-only audit log of every trip state transition.
model TripEvent {
  id         BigInt   @id @default(autoincrement())
  tripId     String   @map("trip_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(16)
  toStatus   String   @map("to_status") @db.VarChar(16)
  actor      String?  @db.VarChar(10)
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_events")
}

model SavedPlace {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  label   String  @db.VarChar(40)
  address String?
  lat     Float
  lng     Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model FareConfig {
  tier       String   @id @db.VarChar(12)
  label      String   @db.VarChar(30)
  baseFare   Float    @map("base_fare")
  perMile    Float    @map("per_mile")
  perMin     Float    @map("per_min")
  bookingFee Float    @map("booking_fee")
  minFare    Float    @map("min_fare")
  capacity   Int
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fare_config")
}

/// Calibratable competitor rate card (Uber/Lyft/Empower) for the price-comparison
/// feature. Seeded from code defaults (competitor-config.ts); `perMile`/`perMin`/
/// `baseFare` are re-fitted from observed FareSample rows by CalibrationService so
/// estimates track reality per market. `calibrated`/`sampleCount`/`residualPct`
/// record the last fit's provenance and quality. These are MODELED estimates, not
/// live quotes — see competitor-config.ts.
model CompetitorFareModel {
  provider         String   @id @db.VarChar(20)
  displayName      String   @map("display_name") @db.VarChar(40)
  productName      String   @map("product_name") @db.VarChar(40)
  baseFare         Float    @map("base_fare")
  perMile          Float    @map("per_mile")
  perMin           Float    @map("per_min")
  bookingFee       Float    @map("booking_fee")
  minFare          Float    @map("min_fare")
  surgeSensitivity Float    @map("surge_sensitivity")
  calibrated       Boolean  @default(false)
  sampleCount      Int      @default(0) @map("sample_count")
  residualPct      Float    @default(0) @map("residual_pct")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("competitor_fare_models")
}

/// An observed real competitor fare for a known trip, used to calibrate the
/// CompetitorFareModel coefficients. `surgeAtSample` lets the fitter de-surge the
/// sample so the fitted rate card reflects the base (non-surge) fare. Samples are
/// gathered manually / from a small consented panel — never by scraping.
model FareSample {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @db.VarChar(20)
  market        String   @default("miami") @db.VarChar(40)
  distanceM     Int      @map("distance_m")
  durationS     Int      @map("duration_s")
  observedFare  Float    @map("observed_fare")
  surgeAtSample Float    @default(1) @map("surge_at_sample")
  hourBucket    Int      @default(0) @map("hour_bucket")
  source        String   @default("manual") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([provider, market])
  @@map("fare_samples")
}

/// A promotional discount code. `kind` is `flat` (fixed currency amount off) or
/// `percent` (percentage off, optionally capped by `maxDiscount`). Usage is
/// bounded globally (`usageLimit`/`usedCount`) and per-rider (`perUserLimit`).
model PromoCode {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(24)
  kind         String    @default("flat") @db.VarChar(8)
  value        Decimal   @db.Decimal(10, 2)
  maxDiscount  Decimal?  @map("max_discount") @db.Decimal(10, 2)
  minSubtotal  Decimal   @default(0) @map("min_subtotal") @db.Decimal(10, 2)
  usageLimit   Int?      @map("usage_limit")
  usedCount    Int       @default(0) @map("used_count")
  perUserLimit Int       @default(1) @map("per_user_limit")
  active       Boolean   @default(true)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

/// A single redemption of a promo code by a rider on a trip. Used to enforce
/// per-user limits and to audit discounts granted.
model PromoRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  promoId   String   @map("promo_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tripId    String?  @map("trip_id") @db.Uuid
  discount  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
  @@map("promo_redemptions")
}
